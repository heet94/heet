@model IEnumerable<LibraryManagementSystem.Models.Book>
@{
    ViewData["Title"] = "Books";
}
<div class="container mt-4">
    <h2 class="mb-3">📚 Library Books</h2>
    <form class="mb-3" method="get">
        <input type="text" name="search" placeholder="Search by title or author" class="form-control" />
    </form>

    <a asp-action="Create" class="btn btn-primary mb-3">➕ Add Book</a>

    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Title</th>
                <th>Author</th>
                <th>Available</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var book in Model)
                {
                    <tr>
                        <td>@book.Title</td>
                        <td>@book.Author</td>
                        <td>@book.AvailableCopies / @book.TotalCopies</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="3" class="text-center text-muted">No books found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
